<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mt_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <TextView
        style="@style/mt_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MultiTool" />

    <!-- TAB BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/mt_bg_tab_bar"
        android:orientation="horizontal"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/tabCalc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/mt_tab_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/ivTabCalc"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Calculator"
                android:src="@drawable/mt_ic_calculator" />

            <TextView
                android:id="@+id/labelTabCalc"
                style="@style/mt_tab_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calculator" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabLength"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/mt_tab_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/ivTabLength"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Length"
                android:src="@drawable/mt_ic_ruler" />

            <TextView
                android:id="@+id/labelTabLength"
                style="@style/mt_tab_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Length" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <!-- ================= CALCULATOR ================= -->
        <LinearLayout
            android:id="@+id/calcLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/mt_bg_surface"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvExpression"
                    style="@style/mt_expression"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvResult"
                    style="@style/mt_result"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:text="0" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/calcKeys"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/mt_key_num"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:text="AC"
                        android:textSize="22sp" />

                    <TextView
                        style="@style/mt_key_num"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:text="+/-"
                        android:textSize="22sp" />

                    <TextView
                        style="@style/mt_key_num"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:text="%"
                        android:textSize="22sp" />

                    <TextView
                        style="@style/mt_key_op"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:text="÷" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/mt_key_num"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:text="7" />

                    <TextView
                        style="@style/mt_key_num"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:text="8" />

                    <TextView
                        style="@style/mt_key_num"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:text="9" />

                    <TextView
                        style="@style/mt_key_op"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:text="×" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/mt_key_num"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:text="4" />

                    <TextView
                        style="@style/mt_key_num"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:text="5" />

                    <TextView
                        style="@style/mt_key_num"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:text="6" />

                    <TextView
                        style="@style/mt_key_op"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:text="−" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/mt_key_num"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:text="1" />

                    <TextView
                        style="@style/mt_key_num"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:text="2" />

                    <TextView
                        style="@style/mt_key_num"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:text="3" />

                    <TextView
                        style="@style/mt_key_op"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:text="+" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/mt_key_num"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:layout_margin="5dp"
                        android:text="0" />

                    <TextView
                        style="@style/mt_key_num"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:text="." />

                    <TextView
                        style="@style/mt_key_op"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:text="=" />

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- ================= LENGTH CONVERTER ================= -->
        <ScrollView
            android:id="@+id/convLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/mt_ic_ruler" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/mt_section_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Length Converter" />

                        <TextView
                            style="@style/mt_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Convert between different length units." />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/mt_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="From" />

                <Spinner
                    android:id="@+id/spFrom"
                    style="@style/mt_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp" />

                <EditText
                    android:id="@+id/etInput"
                    style="@style/mt_input"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:hint="Enter value"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal" />

                <ImageView
                    android:id="@+id/btnSwap"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:clickable="true"
                    android:contentDescription="Swap units"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/mt_ic_swap" />

                <TextView
                    style="@style/mt_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="To" />

                <Spinner
                    android:id="@+id/spTo"
                    style="@style/mt_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp" />

                <TextView
                    android:id="@+id/tvConvResult"
                    style="@style/mt_input"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:hint="0" />

                <TextView
                    android:id="@+id/btnConvert"
                    style="@style/mt_convert_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="28dp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
