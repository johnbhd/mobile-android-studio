                <ImageView android:id="@id/pilot_image" android:layout_width="@dimen/pilot_image_size" android:layout_height="@dimen/pilot_image_size" android:layout_marginStart="@dimen/machine_card_content_spacing" android:contentDescription="@string/pilot_little_jon_armstrong" android:scaleType="centerCrop" android:src="@drawable/pilot_little_jon_armstrong" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toEndOf="@id/machine_image" app:layout_constraintTop_toTopOf="parent" />
