                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/machine_stat_spacing" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@id/selected_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-condensed" android:text="@string/action_selected" android:textColor="@color/menu_gold" android:textSize="10sp" android:textStyle="bold" android:visibility="gone" /><Button android:id="@id/select_button" android:layout_width="@dimen/machine_select_button_width" android:layout_height="@dimen/machine_select_button_height" android:background="@drawable/machine_select_button" android:fontFamily="sans-serif-condensed" android:stateListAnimator="@null" android:text="@string/action_select" android:textColor="@color/machine_select_button_text" android:textSize="10sp" android:textStyle="bold" /></LinearLayout>
                </LinearLayout>
