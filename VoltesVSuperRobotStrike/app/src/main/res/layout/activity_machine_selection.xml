                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/machine_stat_spacing" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="@dimen/machine_stat_label_width" android:layout_height="wrap_content" android:text="@string/machine_stat_attack" android:textColor="@color/machine_text_muted" android:textSize="9sp" android:textStyle="bold" /><LinearLayout android:id="@id/attack_stat_bar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal"><include layout="@layout/machine_stat_segment_filled" /><include layout="@layout/machine_stat_segment_filled" /><include layout="@layout/machine_stat_segment_filled" /><include layout="@layout/machine_stat_segment_empty" /><include layout="@layout/machine_stat_segment_empty" /></LinearLayout><TextView android:id="@id/attack_value" android:layout_width="@dimen/machine_stat_value_width" android:layout_height="wrap_content" android:gravity="end" android:text="3/5" android:textColor="@color/menu_gold" android:textSize="9sp" android:textStyle="bold" /></LinearLayout>
