                    <TextView android:id="@+id/pilot_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="sans-serif-condensed" android:text="@string/pilot_steve_armstrong" android:textColor="@color/machine_text_muted" android:textSize="10sp" />
