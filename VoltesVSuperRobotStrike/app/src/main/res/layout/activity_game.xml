<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/game_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_background"
    android:clipToPadding="false"
    tools:context=".activities.GameActivity">

    <com.example.voltesvsuperrobotstrike.game.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/skill_button"
        android:layout_width="@dimen/game_skill_button_width"
        android:layout_height="@dimen/game_skill_button_height"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/game_skill_button_margin"
        android:layout_marginBottom="@dimen/game_skill_button_margin"
        android:background="@drawable/skill_button_background"
        android:backgroundTint="@null"
        android:contentDescription="@string/game_skill_button_ready_description"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center"
        android:maxLines="2"
        android:minHeight="@dimen/game_skill_button_height"
        android:minWidth="0dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:stateListAnimator="@null"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/pause_button"
        android:layout_width="@dimen/game_pause_button_size"
        android:layout_height="@dimen/game_pause_button_size"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/game_hud_margin"
        android:layout_marginEnd="@dimen/game_hud_margin"
        android:background="@drawable/pause_button_background"
        android:backgroundTint="@null"
        android:contentDescription="@string/game_pause_button_description"
        android:padding="14dp"
        android:src="@drawable/ic_pause"
        android:stateListAnimator="@null"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:backgroundTint="@null" />

    <FrameLayout
        android:id="@+id/pause_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/game_pause_overlay"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/pause_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/game_pause_panel_margin"
            android:layout_marginEnd="@dimen/game_pause_panel_margin"
            android:background="@drawable/pause_panel_background"
            android:orientation="vertical"
            android:padding="@dimen/game_pause_panel_padding">

            <TextView
                android:id="@+id/pause_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="sans-serif-condensed"
                android:text="@string/game_pause_title"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pause_machine_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/game_pause_title_spacing"
                android:gravity="center"
                android:fontFamily="sans-serif-condensed"
                android:textColor="@color/menu_gold"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pause_difficulty_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="sans-serif-condensed"
                android:textColor="@color/difficulty_normal"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/pause_pilot_image"
                android:layout_width="@dimen/game_pause_pilot_image_size"
                android:layout_height="@dimen/game_pause_pilot_image_size"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/game_pause_pilot_image_spacing"
                android:contentDescription="@string/pilot_steve_armstrong"
                android:importantForAccessibility="yes"
                android:scaleType="fitCenter" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/resume_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/game_pause_button_height"
                android:layout_marginTop="16dp"
                android:background="@drawable/menu_button_primary"
                android:backgroundTint="@null"
                android:contentDescription="@string/game_resume_button_description"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="10dp"
                android:drawableTint="@color/menu_text_primary"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:minHeight="@dimen/game_pause_button_height"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:stateListAnimator="@null"
                android:text="@string/game_pause_resume"
                android:textColor="@color/menu_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/restart_mission_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/game_pause_button_height"
                android:layout_marginTop="@dimen/game_pause_button_spacing"
                android:background="@drawable/menu_button_secondary"
                android:backgroundTint="@null"
                android:contentDescription="@string/game_restart_button_description"
                android:drawableStart="@drawable/ic_restart"
                android:drawablePadding="10dp"
                android:drawableTint="@color/menu_text_secondary"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:minHeight="@dimen/game_pause_button_height"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:stateListAnimator="@null"
                android:text="@string/game_pause_restart"
                android:textColor="@color/menu_text_secondary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/change_machine_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/game_pause_button_height"
                android:layout_marginTop="@dimen/game_pause_button_spacing"
                android:background="@drawable/menu_button_secondary"
                android:backgroundTint="@null"
                android:contentDescription="@string/game_change_machine_button_description"
                android:drawableStart="@drawable/ic_swap"
                android:drawablePadding="10dp"
                android:drawableTint="@color/menu_text_secondary"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:minHeight="@dimen/game_pause_button_height"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:stateListAnimator="@null"
                android:text="@string/game_pause_change_machine"
                android:textColor="@color/menu_text_secondary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/pause_main_menu_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/game_pause_button_height"
                android:layout_marginTop="@dimen/game_pause_button_spacing"
                android:background="@drawable/menu_button_secondary"
                android:backgroundTint="@null"
                android:contentDescription="@string/game_main_menu_button_description"
                android:drawableStart="@drawable/ic_home"
                android:drawablePadding="10dp"
                android:drawableTint="@color/menu_text_secondary"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:minHeight="@dimen/game_pause_button_height"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:stateListAnimator="@null"
                android:text="@string/game_pause_main_menu"
                android:textColor="@color/menu_text_secondary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
