<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/game_over_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/menu_navy"
    tools:context=".activities.GameOverActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/starting_screen" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/menu_overlay_gradient"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/content_spacing">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/menu_panel_background"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/game_over_title"
                        android:textColor="@color/game_over_title"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/game_over_run_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/content_spacing"
                        android:fontFamily="sans-serif-condensed"
                        android:textColor="@color/machine_text_muted"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="VOLT CREWZER • NORMAL" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/content_spacing"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/game_over_final_score"
                        android:textColor="@color/menu_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/final_score_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-monospace"
                        android:textColor="@color/menu_gold"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        tools:text="003250" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/content_spacing"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/game_over_high_score"
                        android:textColor="@color/menu_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/high_score_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-monospace"
                        android:textColor="@color/menu_gold"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        tools:text="008900" />

                    <TextView
                        android:id="@+id/new_high_score_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/content_spacing"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/game_over_new_high_score"
                        android:textColor="@color/menu_gold_light"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/play_again_button"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/main_menu_primary_button_height"
                        android:layout_marginTop="@dimen/content_spacing"
                        android:background="@drawable/menu_button_primary"
                        android:backgroundTint="@null"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:minHeight="@dimen/main_menu_primary_button_height"
                        android:minWidth="0dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:drawableStart="@drawable/ic_play"
                        android:drawablePadding="10dp"
                        android:drawableTint="@color/menu_text_primary"
                        android:stateListAnimator="@null"
                        android:text="@string/game_over_play_again"
                        android:textColor="@color/menu_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/main_menu_button"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/main_menu_secondary_button_height"
                        android:layout_marginTop="@dimen/main_menu_button_spacing"
                        android:background="@drawable/menu_button_secondary"
                        android:backgroundTint="@null"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:minHeight="@dimen/main_menu_secondary_button_height"
                        android:minWidth="0dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:drawableStart="@drawable/ic_arrow_back"
                        android:drawablePadding="10dp"
                        android:drawableTint="@color/menu_text_secondary"
                        android:stateListAnimator="@null"
                        android:text="@string/game_over_main_menu"
                        android:textColor="@color/menu_text_secondary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
