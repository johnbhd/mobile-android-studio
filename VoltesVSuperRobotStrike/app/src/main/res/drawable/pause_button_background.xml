<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/menu_secondary_pressed" />
            <corners android:radius="@dimen/main_menu_corner_radius" />
            <stroke
                android:width="2dp"
                android:color="@color/menu_gold" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/menu_navy" />
            <corners android:radius="@dimen/main_menu_corner_radius" />
            <stroke
                android:width="2dp"
                android:color="@color/menu_metallic_light" />
        </shape>
    </item>

</selector>
