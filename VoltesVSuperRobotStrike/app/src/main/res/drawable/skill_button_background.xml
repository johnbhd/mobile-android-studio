<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/game_skill_disabled" />
            <stroke
                android:width="2dp"
                android:color="@color/game_skill_disabled_border" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/menu_gold_pressed" />
            <stroke
                android:width="2dp"
                android:color="@color/menu_border" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/game_skill_fill" />
            <stroke
                android:width="2dp"
                android:color="@color/game_skill_border" />
        </shape>
    </item>

</selector>
