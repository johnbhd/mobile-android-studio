    <string name="how_to_play_title">HOW TO PLAY</string>
    <string name="how_to_play_intro">Learn the essentials, choose your Volt Machine, and launch into the fight.</string>
    <string name="how_to_play_objective_icon_description">High score objective</string>
    <string name="how_to_play_objective_heading">OBJECTIVE</string>
    <string name="how_to_play_objective_body">Destroy incoming enemies, survive their attacks, collect Power-Ups, and earn the highest score possible.</string>
    <string name="how_to_play_movement_icon_description">Two-dimensional movement</string>
    <string name="how_to_play_movement_heading">MOVEMENT</string>
    <string name="how_to_play_movement_body">Drag your Volt Machine anywhere around the gameplay area. Move left, right, up, down, and diagonally.</string>
    <string name="how_to_play_attack_icon_description">Automatic player projectile</string>
    <string name="how_to_play_attack_heading">ATTACK</string>
    <string name="how_to_play_attack_body">Your Volt Machine automatically fires its normal weapon. No Shoot button is required. Volt Bomber starts with a single shot; a temporary Twin Shot pickup can add a second shot.</string>
    <string name="how_to_play_lives_icon_description">Player life</string>
    <string name="how_to_play_lives_heading">LIVES</string>
    <string name="how_to_play_lives_body">Start with 3 lives. Taking damage removes one life, followed by a short invulnerability period. Extra Life can raise you to a maximum of 5 lives. When all lives are lost, the game ends.</string>
    <string name="how_to_play_powerups_heading">POWER-UPS</string>
    <string name="how_to_play_powerup_shield">SHIELD - Blocks one valid enemy hit.</string>
    <string name="how_to_play_powerup_rapid_fire">RAPID FIRE - Temporarily increases firing speed.</string>
    <string name="how_to_play_powerup_double_score">DOUBLE SCORE - Temporarily increases score from enemy kills.</string>
    <string name="how_to_play_powerup_extra_life">EXTRA LIFE - Adds one life, up to the maximum of 5.</string>
    <string name="how_to_play_skills_heading">SPECIAL SKILLS</string>
    <string name="how_to_play_skill_crewzer_name">Crewzer Overdrive</string>
    <string name="how_to_play_skill_crewzer">VOLT CREWZER - Crewzer Overdrive boosts movement and weapon performance while granting immunity.</string>
    <string name="how_to_play_skill_bomber_name">Bombardment Strike</string>
    <string name="how_to_play_skill_bomber">VOLT BOMBER - Bombardment Strike launches manual bombardment bombs that explode on impact.</string>
    <string name="how_to_play_skill_panzer_name">Power Shot</string>
    <string name="how_to_play_skill_panzer">VOLT PANZER - Power Shot fires a larger, more powerful special projectile.</string>
    <string name="how_to_play_skill_frigate_name">Rapid Barrage</string>
    <string name="how_to_play_skill_frigate">VOLT FRIGATE - Rapid Barrage temporarily fires twin shots at a very high rate.</string>
    <string name="how_to_play_skill_lander_name">Energy Shield</string>
    <string name="how_to_play_skill_lander">VOLT LANDER - Energy Shield creates protection that blocks enemy attacks.</string>
    <string name="how_to_play_enemies_icon_description">Incoming enemy</string>
    <string name="how_to_play_enemies_heading">ENEMIES</string>
    <string name="how_to_play_enemies_body">Enemies enter the battlefield, move using different patterns, and some can fire projectiles. Destroying enemies earns score.</string>
    <string name="how_to_play_difficulty_heading">DIFFICULTY</string>
    <string name="how_to_play_difficulty_easy">EASY - Lower gameplay pressure.</string>
    <string name="how_to_play_difficulty_normal">NORMAL - Balanced gameplay.</string>
    <string name="how_to_play_difficulty_hard">HARD - Higher enemy and spawn pressure.</string>
    <string name="how_to_play_pause_icon_description">Pause controls</string>
    <string name="how_to_play_pause_heading">PAUSE</string>
    <string name="how_to_play_pause_body">The Pause button lets you Resume, Restart Mission, Change Machine, or Return to Main Menu.</string>
    <string name="how_to_play_game_over_icon_description">Game Over score</string>
    <string name="how_to_play_game_over_heading">GAME OVER</string>
    <string name="how_to_play_game_over_body">When all lives are lost, the Game Over screen displays your Final Score and High Score, with options to Play Again or return to Main Menu.</string>
    <string name="how_to_play_back_to_menu">BACK TO MENU</string>

